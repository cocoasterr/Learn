<odoo>
  <data>
    <!-- model.name inherit form view -->
    <record id="res_partner_auto_invoices_form_view" model="ir.ui.view">
      <field name="name">res_partner_auto_invoices_form_view</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">  
        <xpath expr="//div[@class='oe_button_box']" position="inside">
          <button name="action_create_invoices"
            string="Create Invoices"
            type="object"
          />
        </xpath>
      </field>
    </record>

    <!-- model.name action server -->
    <record id="action_create_invoices" model="ir.actions.server">
      <field name="name">Create Invoices</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="binding_model_id" ref="base.model_res_partner"/>
      <field name="state">code</field>
      <field name="code">
        if records:
          action = records.action_create_invoices()
      </field>
    </record>
  </data>
</odoo>