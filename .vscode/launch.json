{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo: Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "odoo-bin", 
      "args": [
        "-c", "config/odoo.conf", // File konfigurasi Odoo
        "-d", "odoo16-db", // Nama database Odoo
        "-u","om_bank,om_kota",
        "--dev=all",
        // "-u","om_pos,point_of_sale,om_js,contacts",
        // "-i", "base", // install

        // Tambahkan modul yang ingin diupdate (opsional)
        // "-u", "modul1,modul2"
        // "--stop-after-init" // Hentikan setelah inisialisasi (opsional)
      ],
      "justMyCode": false, // Memungkinkan debug ke semua kode termasuk kode library
      "console": "integratedTerminal", // Jalankan di terminal VS Code
      "env": {
        "PYTHONPATH": "${workspaceFolder}" // Menambahkan workspace sebagai path Python
      }
    }
  ]
}


